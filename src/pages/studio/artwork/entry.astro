---
import StudioLayout from "../../../layouts/StudioLayout.astro";
import { PRICING_SCENARIOS } from "../../../lib/artwork";
---

<StudioLayout title="Artwork Record | Rob White Studio" activePage="artwork">
  <a class="studio-back-link" href="/studio/artwork">← Back to Artwork</a>
  <p class="studio-alert" data-studio-error hidden></p>
  <p class="studio-loading" data-artwork-loading>Opening the artwork record…</p>

  <article data-artwork-detail hidden>
    <header class="artwork-detail-header">
      <div>
        <p class="eyebrow" data-artwork-inventory>Artwork</p>
        <h1 data-artwork-title></h1>
        <p class="studio-lede" data-artwork-subtitle></p>
        <div class="studio-chip-row artwork-status-row"><span class="studio-chip" data-production-status></span><span class="studio-chip" data-availability></span></div>
      </div>
      <div class="artwork-detail-actions">
        <a class="studio-button" data-artwork-edit href="/studio/artwork/edit">Edit Artwork</a>
        <button class="studio-button studio-button-danger" type="button" data-delete-artwork>Delete</button>
      </div>
    </header>

    <nav class="artwork-tabs" aria-label="Artwork sections">
      <button type="button" data-artwork-tab="overview" class="is-active">Overview</button>
      <button type="button" data-artwork-tab="images">Images</button>
      <button type="button" data-artwork-tab="journal">Process / Journal</button>
      <button type="button" data-artwork-tab="costs">Cost & Pricing</button>
      <button type="button" data-artwork-tab="activity">Activity</button>
    </nav>

    <section class="artwork-panel" data-artwork-panel="overview">
      <div class="artwork-overview-grid">
        <div class="artwork-primary-image" data-primary-image><p>No primary image yet.</p></div>
        <div class="artwork-facts">
          <dl data-artwork-facts></dl>
          <div class="artwork-story" data-artwork-story></div>
        </div>
      </div>
    </section>

    <section class="artwork-panel" data-artwork-panel="images" hidden>
      <div class="artwork-section-heading"><div><p class="eyebrow">Images</p><h2>Visual record</h2></div><a class="studio-button studio-button-quiet" data-artwork-edit-images href="/studio/artwork/edit">Add Images</a></div>
      <div class="studio-gallery artwork-gallery" data-artwork-images></div>
      <p class="studio-empty artwork-inline-empty" data-artwork-images-empty hidden>No images have been added.</p>
    </section>

    <section class="artwork-panel" data-artwork-panel="journal" hidden>
      <div class="artwork-section-heading"><div><p class="eyebrow">Process / Journal</p><h2>Related entries</h2></div><a class="studio-button studio-button-quiet" data-new-related-journal href="/studio/journal/new">New Related Entry</a></div>
      <div class="studio-entry-list" data-related-journal></div>
      <p class="studio-empty artwork-inline-empty" data-related-journal-empty hidden>No Journal entries are related yet.</p>
    </section>

    <section class="artwork-panel" data-artwork-panel="costs" hidden>
      <div class="cost-summary" data-cost-summary></div>

      <section class="artwork-work-section">
        <div class="artwork-section-heading">
          <div><p class="eyebrow">Cash expenses</p><h2>Cost entries</h2></div>
          <div class="artwork-detail-actions">
            <button class="studio-button studio-button-quiet" type="button" data-add-category>Add Category</button>
            <button class="studio-button studio-button-quiet" type="button" data-toggle-form="cost">Add Cost Entry</button>
          </div>
        </div>
        <form class="studio-inline-form" data-cost-form hidden>
          <div class="studio-form-row studio-form-row-3">
            <div class="studio-field"><label for="cost-category">Category</label><select id="cost-category" name="category_id" required data-cost-category></select></div>
            <div class="studio-field"><label for="cost-item">Item or material</label><input id="cost-item" name="item_name" required /></div>
            <div class="studio-field"><label for="cost-date">Entry date</label><input id="cost-date" name="entry_date" type="date" required /></div>
          </div>
          <div class="studio-form-row studio-form-row-3">
            <div class="studio-field"><label for="cost-brand">Manufacturer / brand</label><input id="cost-brand" name="manufacturer" /></div>
            <div class="studio-field"><label for="cost-variant">Color / variant</label><input id="cost-variant" name="color_variant" /></div>
            <div class="studio-field"><label for="cost-vendor">Vendor / source</label><input id="cost-vendor" name="vendor" /></div>
          </div>
          <div class="studio-form-row studio-form-row-4">
            <div class="studio-field"><label for="cost-unit">Unit</label><input id="cost-unit" name="unit" value="each" /></div>
            <div class="studio-field"><label for="purchase-qty">Purchase quantity</label><input id="purchase-qty" name="purchase_quantity" type="number" min="0.0001" step="0.0001" /></div>
            <div class="studio-field"><label for="purchase-cost">Purchase cost</label><input id="purchase-cost" name="purchase_cost" inputmode="decimal" placeholder="$0.00" /></div>
            <div class="studio-field"><label for="amount-used">Amount used</label><input id="amount-used" name="amount_used" type="number" min="0" step="0.0001" /></div>
          </div>
          <div class="studio-form-row">
            <div class="studio-field"><label for="allocated-cost">Direct allocated cost</label><input id="allocated-cost" name="allocated_cost" inputmode="decimal" placeholder="$0.00" /><small>Use when the usage amount cannot be estimated.</small></div>
            <div class="studio-field"><label for="manual-cost">Manual override</label><input id="manual-cost" name="manual_cost_override" inputmode="decimal" placeholder="Leave blank to calculate" /><small>A manual value is never overwritten.</small></div>
          </div>
          <div class="studio-field"><label for="cost-notes">Notes</label><textarea id="cost-notes" name="notes" rows="3"></textarea></div>
          <div class="studio-form-actions"><button class="studio-button" type="submit">Save Cost</button></div>
        </form>
        <div class="artwork-cost-groups" data-cost-groups></div>
      </section>

      <section class="artwork-work-section">
        <div class="artwork-section-heading"><div><p class="eyebrow">Studio labor value</p><h2>Labor log</h2></div><button class="studio-button studio-button-quiet" type="button" data-toggle-form="labor">Add Labor</button></div>
        <form class="studio-inline-form" data-labor-form hidden>
          <div class="studio-form-row studio-form-row-4">
            <div class="studio-field"><label for="labor-task">Task</label><input id="labor-task" name="task" required /></div>
            <div class="studio-field"><label for="labor-date">Date</label><input id="labor-date" name="entry_date" type="date" required /></div>
            <div class="studio-field"><label for="labor-hours">Hours</label><input id="labor-hours" name="hours" type="number" min="0.01" step="0.25" required /></div>
            <div class="studio-field"><label for="labor-rate">Hourly value</label><input id="labor-rate" name="hourly_value" inputmode="decimal" required placeholder="$0.00" /></div>
          </div>
          <div class="studio-field"><label for="labor-notes">Notes</label><textarea id="labor-notes" name="notes" rows="3"></textarea></div>
          <div class="studio-form-actions"><button class="studio-button" type="submit">Save Labor</button></div>
        </form>
        <div class="artwork-record-list" data-labor-list></div>
      </section>

      <section class="artwork-work-section">
        <div class="artwork-section-heading"><div><p class="eyebrow">Sales channels</p><h2>Pricing scenarios</h2></div><button class="studio-button studio-button-quiet" type="button" data-toggle-form="pricing">Add Scenario</button></div>
        <form class="studio-inline-form" data-pricing-form hidden>
          <div class="studio-form-row studio-form-row-3">
            <div class="studio-field"><label for="scenario-name">Scenario</label><select id="scenario-name" name="scenario_name">{PRICING_SCENARIOS.map((name) => <option value={name}>{name}</option>)}</select></div>
            <div class="studio-field"><label for="listed-price">Listed sale price</label><input id="listed-price" name="listed_price" inputmode="decimal" required placeholder="$0.00" /></div>
            <div class="studio-field"><label for="commission">Commission %</label><input id="commission" name="commission_percent" type="number" min="0" max="100" step="0.1" value="0" /></div>
          </div>
          <div class="studio-form-row studio-form-row-4">
            <div class="studio-field"><label for="platform-fee">Payment / platform %</label><input id="platform-fee" name="platform_fee_percent" type="number" min="0" max="100" step="0.1" value="0" /></div>
            <div class="studio-field"><label for="fixed-fee">Fixed fee</label><input id="fixed-fee" name="fixed_fee" inputmode="decimal" value="0" /></div>
            <div class="studio-field"><label for="discount-percent">Discount %</label><input id="discount-percent" name="discount_percent" type="number" min="0" max="100" step="0.1" value="0" /></div>
            <div class="studio-field"><label for="discount-amount">Discount amount</label><input id="discount-amount" name="discount_amount" inputmode="decimal" value="0" /></div>
          </div>
          <div class="studio-form-row studio-form-row-3">
            <div class="studio-field"><label for="shipping-absorbed">Shipping absorbed</label><input id="shipping-absorbed" name="shipping_absorbed" inputmode="decimal" value="0" /></div>
            <div class="studio-field"><label for="other-deductions">Other deductions</label><input id="other-deductions" name="other_deductions" inputmode="decimal" value="0" /></div>
            <div class="studio-field"><label for="pricing-notes">Notes</label><input id="pricing-notes" name="notes" /></div>
          </div>
          <div class="studio-form-actions"><button class="studio-button" type="submit">Save Scenario</button></div>
        </form>
        <div class="pricing-scenario-grid" data-pricing-list></div>
      </section>

      <section class="artwork-work-section">
        <div class="artwork-section-heading"><div><p class="eyebrow">Retained decisions</p><h2>Price history</h2></div><button class="studio-button studio-button-quiet" type="button" data-toggle-form="history">Record Price</button></div>
        <form class="studio-inline-form" data-history-form hidden>
          <div class="studio-form-row studio-form-row-4">
            <div class="studio-field"><label for="history-price">Price</label><input id="history-price" name="price" inputmode="decimal" required /></div>
            <div class="studio-field"><label for="history-type">Type / channel</label><input id="history-type" name="price_type" required placeholder="Studio retail" /></div>
            <div class="studio-field"><label for="history-effective">Effective date</label><input id="history-effective" name="effective_date" type="date" required /></div>
            <div class="studio-field"><label for="history-end">End date</label><input id="history-end" name="end_date" type="date" /></div>
          </div>
          <div class="studio-field"><label for="history-reason">Reason or note</label><input id="history-reason" name="reason" /></div>
          <div class="studio-form-actions"><button class="studio-button" type="submit">Record Price</button></div>
        </form>
        <div class="artwork-record-list" data-price-history></div>
      </section>
    </section>

    <section class="artwork-panel" data-artwork-panel="activity" hidden>
      <div class="artwork-section-heading"><div><p class="eyebrow">Activity</p><h2>Studio history</h2></div></div>
      <div class="studio-feed-cards" data-artwork-activity></div>
      <p class="studio-empty artwork-inline-empty" data-artwork-activity-empty hidden>No meaningful activity has been recorded.</p>
    </section>
  </article>
</StudioLayout>

<script>
  import "../../../scripts/artwork-entry";
</script>
